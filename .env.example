# ============================================================
# 深度调研 Agent · 环境变量模板
# 使用方法：把本文件复制一份，重命名为 .env，然后填入你的 Key
# ============================================================

# ---------- LLM（任何 OpenAI 兼容接口，选一种即可）----------

# 示例：DeepSeek（推荐，便宜好用）
OPENAI_API_KEY=sk-在这里填你的Key
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 示例：OpenAI 官方（要用官方就把上面三行注释掉，换成下面两行）
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ---------- 搜索（可选）----------
# 不填则自动使用免费的 DuckDuckGo 搜索（可能被限流）
# 填了优先用 Tavily（更稳定、结果质量更高）：https://tavily.com
TAVILY_API_KEY=

# ---------- 运行参数 ----------
MAX_QUERIES=4
MAX_PAGES=8
