# 复制为 .env 后填写。.env 已在 .gitignore 里，不要提交。

# ===== LLM（任何 OpenAI 兼容接口）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ===== 搜索（留空则退回免费的 DuckDuckGo）=====
TAVILY_API_KEY=

# ===== 运行参数 =====
MAX_QUERIES=4
MAX_PAGES=8

# ===== MCP 工具层（内部知识库）=====
# 关掉后 knowledge 节点直接跳过，图结构不变
MCP_ENABLED=true
# 服务端项目目录，默认取同级目录 ../rag-knowledge-chat
# MCP_SERVER_CWD=
# 启动命令，留空自动用服务端项目的 .venv 解释器（服务端依赖 fastembed/faiss）
# MCP_SERVER_COMMAND=
# MCP_SERVER_ARGS=-m mcp_server
# MCP_CONNECT_TIMEOUT=30
# MCP_CALL_TIMEOUT=60
# 检索预算：每个子问题召回几条 / 最多并入几条内部证据 / 最多查几个子问题
# MCP_TOP_K=3
# MCP_MAX_EVIDENCE=3
# MCP_MAX_QUERIES=3
# 服务端日志：默认写 outputs/mcp_server.log；设 inherit 直接打屏
# MCP_STDERR=
# MCP_SERVER_LOG=
